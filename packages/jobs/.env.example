# Jobs (packages/jobs, Trigger.dev) — environment
#
# Set these in the Trigger.dev project's environment variables, and in
# packages/jobs/.env for `bun run jobs:dashboard` locally.
#
# Every background job in this fork runs here, so this list is longer than it
# was when the package held only the bank sync cluster. See README.md for the
# schedules and SELF_HOSTING.md for where each value comes from.

# --- Required ---------------------------------------------------------------

# Supabase session pooler
DATABASE_URL=

# Supabase project. Nearly every task reads or writes the `vault` bucket, so a
# job run without these fails at the first storage call.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# 64-character hex string, 32 bytes; must match the API
MIDDAY_ENCRYPTION_KEY=

# Shared secret for calling the API
INTERNAL_API_KEY=

# Public URLs, used for links in emails and callbacks. Required in production.
DASHBOARD_URL=http://localhost:3001
API_URL=http://localhost:3003
# Optional: where email images are served from; defaults to DASHBOARD_URL.
# EMAIL_ASSETS_URL=

# AI. Document OCR and tag embeddings.
GOOGLE_GENERATIVE_AI_API_KEY=

# Enable Banking. `@midday/banking` validates these when it loads, and the
# institution sync imports it, so an unset value is a startup error rather than
# a feature that quietly does nothing.
ENABLEBANKING_APPLICATION_ID=
ENABLE_BANKING_KEY_CONTENT=
ENABLEBANKING_REDIRECT_URL=

# Trigger.dev project reference, read by trigger.config.ts
TRIGGER_PROJECT_ID=

# --- Email ------------------------------------------------------------------

# Required to send at all; the domain has to be verified with Resend.
RESEND_API_KEY=
EMAIL_FROM=Midday <midday@example.com>
# EMAIL_FROM_NAME=
# The audience new sign-ups are added to.
RESEND_AUDIENCE_ID=

# --- Optional, per feature --------------------------------------------------

# GoCardless, if you use it alongside Enable Banking.
# GOCARDLESS_SECRET_ID=
# GOCARDLESS_SECRET_KEY=

# Signs the public invoice links that go into invoice emails.
# INVOICE_JWT_SECRET=

# Document OCR fallback.
# MISTRAL_API_KEY=

# Summarises a Slack-uploaded receipt back into the thread.
# OPENAI_API_KEY=

# Inbox sync. Same OAuth client as the API and the dashboard.
# GMAIL_CLIENT_ID=
# GMAIL_CLIENT_SECRET=
# GMAIL_REDIRECT_URI=
# OUTLOOK_CLIENT_ID=
# OUTLOOK_CLIENT_SECRET=
# OUTLOOK_REDIRECT_URI=

# Accounting export. Token refresh needs the client credentials.
# XERO_CLIENT_ID=
# XERO_CLIENT_SECRET=
# XERO_OAUTH_REDIRECT_URL=
# QUICKBOOKS_CLIENT_ID=
# QUICKBOOKS_CLIENT_SECRET=
# QUICKBOOKS_OAUTH_REDIRECT_URL=
# FORTNOX_CLIENT_ID=
# FORTNOX_CLIENT_SECRET=
# FORTNOX_OAUTH_REDIRECT_URL=

# --- Switches ---------------------------------------------------------------

# Scheduled tasks (on unless set to "false"; they used to run only in
# Midday's production Trigger.dev environment). See README.md for the full
# schedule table and the free plan's budget of ten.
BANK_SYNC_SCHEDULER_ENABLED=true
INVOICE_SCHEDULER_ENABLED=true
NO_MATCH_SCHEDULER_ENABLED=true
RATES_SCHEDULER_ENABLED=true
SYNC_INSTITUTIONS_ENABLED=true

# Weekly insight emails. Off unless exactly "true", and no schedule is
# registered for the dispatcher either, so this alone starts nothing.
# INSIGHTS_ENABLED=false
# INSIGHTS_NOTIFICATIONS_ENABLED=false
# Comma-separated team ids; unset means every eligible team.
# INSIGHTS_ENABLED_TEAM_IDS=

# Kill switches for the invoice schedules, togglable without a deploy. Unlike
# the flags above these are off-by-default-absent: only "true" disables.
# DISABLE_RECURRING_INVOICES=true
# DISABLE_UPCOMING_NOTIFICATIONS=true

# Dry run for the two invoice schedules: they work out exactly which recurring
# series would generate and who would be emailed, log it, and send nothing.
# Note the polarity is the opposite of the five flags above — this one is off
# unless you turn it on.
# INVOICE_JOBS_DRY_RUN=true
