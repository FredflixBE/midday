# Database (packages/db) — environment for the scripts in src/scripts.
# Copy to packages/db/.env.
#
# `bun run --cwd packages/db ...` loads this file, which is why it is the one
# that has reached the real books by accident. Say which database it points at.

# production | development | test. The scripts print it before they act and
# refuse to write to production without CONFIRM_DATABASE_PROD=true. Unset is
# refused too: an unlabelled remote database might be the real one.
DATABASE_ENVIRONMENT=development

# Supabase session pooler, port 5432. DATABASE_URL is what the analysis scripts
# read; DATABASE_SESSION_POOLER is what drizzle-kit, db:bootstrap and db:stamp
# read. They are usually the same value.
DATABASE_URL=
DATABASE_SESSION_POOLER=

# The test database, for test:e2e:setup and verify:migrations. Must be on
# localhost — those scripts drop and recreate it.
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5433/midday_test
