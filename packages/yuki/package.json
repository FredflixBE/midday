{
  "name": "@midday/yuki",
  "version": "1.0.0",
  "private": true,
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./archive": "./src/archive.ts",
    "./team": "./src/team.ts"
  },
  "scripts": {
    "clean": "rm -rf .turbo node_modules",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "test": "bun test --exit src",
    "explore": "bun run scripts/explore.ts",
    "archive": "bun run scripts/archive.ts",
    "backlog": "bun run scripts/backlog.ts",
    "team-archive": "bun run scripts/team-archive.ts"
  },
  "dependencies": {
    "@midday/db": "workspace:*",
    "@midday/encryption": "workspace:*",
    "@midday/utils": "workspace:*",
    "fast-xml-parser": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "latest"
  }
}
