# Yuki / Nmbrs Accounting web service credentials.
#
# Create the access key in Yuki: Settings -> Web services -> +
# The administration ID is on the same screen.
#
# Keep these here, in packages/yuki/.env. Do NOT put them in packages/db/.env:
# `bun run` auto-loads the nearest .env, and that file points at the live
# Frankfurt Supabase project.

YUKI_ACCESS_KEY=
YUKI_ADMINISTRATION_ID=

# "be" for Belgian domains (api.yukiworks.be), "nl" for Dutch (api.yukiworks.nl).
# The wrong one returns "Domain has no active database".
YUKI_REGION=be
