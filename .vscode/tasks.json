{
  // A script started from the NPM Scripts pane runs as an auto-detected task,
  // and an auto-detected task is one-shot in a *shared* terminal: the next
  // script launched from the pane takes that terminal over and SIGTERMs
  // whatever is running in it. That is what kills the dev servers mid-session.
  //
  // `panel: "dedicated"` is what stops the kill — the terminal is that task's
  // and no other task may claim it. `isBackground` is what stops the runner
  // treating a server that never returns as a task that finished.
  //
  // These entries match the detected tasks by script name, and the nested ones
  // by the package directory as well, since the pane lists every workspace's
  // scripts and not only the root's. Anything one-shot — test, build, lint,
  // db:* — is deliberately absent.
  "version": "2.0.0",
  "tasks": [
    {
      "type": "npm",
      "script": "dev",
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "panel": "dedicated",
        "reveal": "always"
      },
      "detail": "Long-running. Every app and package in parallel."
    },
    {
      "type": "npm",
      "script": "dev:api",
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "panel": "dedicated",
        "reveal": "always"
      },
      "detail": "Long-running. The API on :3003."
    },
    {
      "type": "npm",
      "script": "dev:dashboard",
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "panel": "dedicated",
        "reveal": "always"
      },
      "detail": "Long-running. The dashboard on :3001."
    },
    {
      "type": "npm",
      "script": "dev:desktop",
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "panel": "dedicated",
        "reveal": "always"
      },
      "detail": "Long-running. The desktop app."
    },
    {
      "type": "npm",
      "script": "jobs:dev",
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "panel": "dedicated",
        "reveal": "always"
      },
      "detail": "Long-running. The Trigger.dev dev worker."
    },
    {
      "type": "npm",
      "script": "start:dashboard",
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "panel": "dedicated",
        "reveal": "always"
      },
      "detail": "Long-running. The built dashboard, production mode."
    },
    {
      "type": "npm",
      "script": "dev",
      "path": "apps/api/",
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "panel": "dedicated",
        "reveal": "always"
      },
      "detail": "Long-running. The API on :3003."
    },
    {
      "type": "npm",
      "script": "dev",
      "path": "apps/dashboard/",
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "panel": "dedicated",
        "reveal": "always"
      },
      "detail": "Long-running. The dashboard on :3001."
    },
    {
      "type": "npm",
      "script": "dev",
      "path": "packages/jobs/",
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "panel": "dedicated",
        "reveal": "always"
      },
      "detail": "Long-running. The Trigger.dev dev worker."
    }
  ]
}
