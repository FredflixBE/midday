{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "dev",
  "description": "default.json's permissions for the local dashboard. Only tauri.dev.conf.json enables it, so a production build never trusts localhost.",
  "windows": ["main", "search"],
  "permissions": [
    "allow-show-window",
    "core:window:default",
    "core:window:allow-hide",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-start-dragging",
    "core:event:default",
    "core:path:default",
    "core:resources:default",
    "opener:default",
    "dialog:allow-save",
    "fs:allow-open",
    "fs:allow-write"
  ],
  "remote": {
    "urls": ["http://localhost:3001/**"]
  },
  "platforms": ["macOS", "windows", "linux"]
}
