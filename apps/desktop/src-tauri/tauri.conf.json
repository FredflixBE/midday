      }
    },
    "icon": [
      "icons/production/32x32.png",
      "icons/production/128x128.png",
      "icons/production/128x128@2x.png",
      "icons/production/icon.icns",
      "icons/production/icon.ico"
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["hq"]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk0Mjg3Q0QyNjcxMTk3NUUKUldSZWx4Rm4wbndvbEYwRUVwVDZpcXRINzBkdGRSMnhyNWhFdFVYTlpBaU0vQ0xiMDk0TmM1WlkK",
      "endpoints": [
        "https://github.com/FredflixBE/midday/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
