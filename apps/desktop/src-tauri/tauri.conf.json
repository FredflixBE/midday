{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HQ",
  "identifier": "be.fredflix.hq",
  "mainBinaryName": "HQ",
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": true,
    "security": {
      "csp": null,
      "dangerousDisableAssetCspModification": true,
      "freezePrototype": false,
      "capabilities": ["default"]
