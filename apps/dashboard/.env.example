# Dashboard (apps/dashboard) — environment
# Copy to apps/dashboard/.env for local development.
#
# In Dokploy, every NEXT_PUBLIC_* value is a BUILD ARGUMENT (it is inlined at
# `next build`), the rest is runtime environment. See SELF_HOSTING.md.

# --- Build arguments (NEXT_PUBLIC_*) ---
NEXT_PUBLIC_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3003
# Supabase project settings > API
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ID=
# Google Maps (address autocomplete, optional)
NEXT_PUBLIC_GOOGLE_API_KEY=
# Stripe Connect invoice payments (optional)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Deep-link scheme of the desktop build you install: midday or midday-dev
NEXT_PUBLIC_DESKTOP_SCHEME=midday

# --- Runtime environment ---
# Optional: private URL of the API for server-side requests (skips the public proxy).
# API_INTERNAL_URL=http://api:8080
SUPABASE_SECRET_KEY=
REDIS_URL=redis://localhost:6379

# Secrets (generate: openssl rand -hex 32). Must match the API where the name is shared.
INVOICE_JWT_SECRET=
FILE_KEY_SECRET=
WEBHOOK_SECRET_KEY=
MIDDAY_CACHE_API_SECRET=
# Base64, 32 bytes (openssl rand -base64 32). Must be identical across replicas.
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# AI
OPENAI_API_KEY=
# Azure Document Intelligence (optional)
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_KEY=

# Support tickets via Plain (optional)
PLAIN_API_KEY=

# Inbox: Gmail (Google Cloud OAuth client with Gmail scopes)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:3003/apps/gmail/oauth-callback

# Inbox: Outlook (Azure app registration)
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=
OUTLOOK_REDIRECT_URI=http://localhost:3003/apps/outlook/oauth-callback
