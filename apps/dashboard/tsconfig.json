{
  "extends": "@midday/tsconfig/nextjs.json",
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"],
      "@api/*": ["../api/src/*"],
      "@jobs/*": ["../../packages/jobs/src/*"],
      // For the shadcn CLI: components.json's `ui` alias resolves through
      // these so `shadcn add` writes into packages/ui (FF-1774).
      "@midday/ui": ["../../packages/ui/src/components"],
      "@midday/ui/cn": ["../../packages/ui/src/utils/cn.ts"],
      "@midday/ui/hooks": ["../../packages/ui/src/hooks"]
    },
    "strict": true
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "../../types",
    "next-env.d.ts",
    "next.config.js",
    ".next/types/**/*.ts"
  ],
  "exclude": ["node_modules", ".next"]
}
