# Resend
RESEND_API_KEY=

# Supabase
SUPABASE_SECRET_KEY=
SUPABASE_URL=
# Legacy HS256 fallback — remove after revoking the legacy JWT secret in Supabase
SUPABASE_JWT_SECRET=

# Supabase - Database
DATABASE_URL= # Session pooler URL (pooler.supabase.com, port 5432)

# Used by drizzle-kit for migrations (can be the same as DATABASE_URL)
DATABASE_SESSION_POOLER=

# Banking Providers (Enable Banking is required; GoCardless is optional)
ENABLEBANKING_APPLICATION_ID=
ENABLE_BANKING_KEY_CONTENT=
ENABLEBANKING_REDIRECT_URL=
GOCARDLESS_SECRET_ID=
GOCARDLESS_SECRET_KEY=

# R2 Storage (institution logos, optional)
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# LLMS
OPENAI_API_KEY=

# Config
ALLOWED_API_ORIGINS="http://localhost:3001"
LOG_LEVEL=debug
INVOICE_JWT_SECRET=
MIDDAY_ENCRYPTION_KEY=
MIDDAY_DASHBOARD_URL="http://localhost:3001"

# Environment
NODE_ENV=development

# Redis Cache
REDIS_URL=redis://localhost:6379

# Google
GOOGLE_GENERATIVE_AI_API_KEY=

# Redis Queue (used by BullMQ)
REDIS_QUEUE_URL=redis://localhost:6379

# Logger
LOG_PRETTY=true

# Inbox Webhook
INBOX_WEBHOOK_USERNAME=
INBOX_WEBHOOK_PASSWORD=

# File Key Secret
FILE_KEY_SECRET=secret

# Slack Integration
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_OAUTH_REDIRECT_URL=http://localhost:3003/apps/slack/oauth-callback
SLACK_STATE_SECRET=
SLACK_SIGNING_SECRET=
# Optional but recommended when storing multi-workspace Slack installations
SLACK_ENCRYPTION_KEY=

# Outlook
OUTLOOK_CLIENT_ID=<your-client-id>
OUTLOOK_CLIENT_SECRET=<your-client-secret>
OUTLOOK_REDIRECT_URI=http://localhost:3003/apps/outlook/oauth-callback

# Mistral
MISTRAL_API_KEY=

# Xero
XERO_CLIENT_ID=your_client_id_here
XERO_CLIENT_SECRET=your_client_secret_here
XERO_OAUTH_REDIRECT_URL=http://localhost:3003/apps/xero/oauth-callback

# QuickBooks
QUICKBOOKS_CLIENT_ID=your_client_id
QUICKBOOKS_CLIENT_SECRET=your_client_secret
QUICKBOOKS_OAUTH_REDIRECT_URL=http://localhost:3003/apps/quickbooks/oauth-callback
QUICKBOOKS_ENVIRONMENT=sandbox

# Fortnox
FORTNOX_CLIENT_ID=your_client_id_here
FORTNOX_CLIENT_SECRET=your_client_secret_here
FORTNOX_OAUTH_REDIRECT_URL=http://localhost:3003/apps/fortnox/oauth-callback

# Stripe
STRIPE_SECRET_KEY=your_secret_key_here
STRIPE_PUBLISHABLE_KEY=your_publishable_key_here
STRIPE_CONNECT_CLIENT_ID=your_connect_client_id_here
STRIPE_CONNECT_WEBHOOK_SECRET=your_webhook_secret_here

# Midday API URL
MIDDAY_API_URL=http://localhost:3003

# Trigger.dev
TRIGGER_SECRET_KEY=

# Internal API Key
INTERNAL_API_KEY=

# Anthropic

# Composio (AI tool connectors)
COMPOSIO_API_KEY=