# API (apps/api) — runtime environment
# Copy to apps/api/.env for local development. In Dokploy, paste these as the
# application's environment. See SELF_HOSTING.md for where each value comes from.

# --- Environment ---
NODE_ENV=development
PORT=3003
LOG_LEVEL=debug
LOG_PRETTY=true

# --- URLs ---
# Public URL of the dashboard; used for CORS and for links in emails.
MIDDAY_DASHBOARD_URL=http://localhost:3001
DASHBOARD_URL=http://localhost:3001
ALLOWED_API_ORIGINS=http://localhost:3001
# Public URL of this API; used for OAuth redirect URLs and the MCP server.
MIDDAY_API_URL=http://localhost:3003
API_URL=http://localhost:3003

# --- Supabase (project settings > API) ---
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Legacy HS256 fallback; only needed until the legacy JWT secret is revoked in Supabase.
SUPABASE_JWT_SECRET=

# --- Database (Supabase project settings > Database > session pooler, port 5432) ---
DATABASE_URL=
# Used by drizzle-kit for migrations; can be the same value as DATABASE_URL.
DATABASE_SESSION_POOLER=
# Optional: max connections in the pool (default 10 outside development).
# DB_POOL_MAX=10

# --- Redis ---
# Cache and BullMQ queue. Both can point at the same Redis.
REDIS_URL=redis://localhost:6379
REDIS_QUEUE_URL=redis://localhost:6379

# --- Secrets (generate: openssl rand -hex 32) ---
# 64-character hex string, 32 bytes. Encrypts provider tokens at rest.
MIDDAY_ENCRYPTION_KEY=
INVOICE_JWT_SECRET=
FILE_KEY_SECRET=
# Shared secret between the API, the worker and the jobs for service-to-service calls.
INTERNAL_API_KEY=
# Basic auth for the inbound inbox email webhook.
INBOX_WEBHOOK_USERNAME=
INBOX_WEBHOOK_PASSWORD=

# --- Banking (Enable Banking is required; GoCardless is optional) ---
ENABLEBANKING_APPLICATION_ID=
ENABLE_BANKING_KEY_CONTENT=
ENABLEBANKING_REDIRECT_URL=
GOCARDLESS_SECRET_ID=
GOCARDLESS_SECRET_KEY=

# --- Institution logos in R2 (optional; without it the provider's logo URL is used) ---
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# --- Email (Resend) ---
RESEND_API_KEY=
# Audience new users are added to (optional)
RESEND_AUDIENCE_ID=

# --- AI ---
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
MISTRAL_API_KEY=
# Composio (AI tool connectors, optional)
COMPOSIO_API_KEY=

# --- Support tickets via Plain (optional; only the health probe reads it here) ---
PLAIN_API_KEY=

# --- Background jobs (Trigger.dev) ---
TRIGGER_SECRET_KEY=

# --- Inbox: Gmail (Google Cloud OAuth client with Gmail scopes; must match the dashboard) ---
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:3003/apps/gmail/oauth-callback

# --- Inbox: Outlook (Azure app registration) ---
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=
OUTLOOK_REDIRECT_URI=http://localhost:3003/apps/outlook/oauth-callback

# --- Slack app (optional) ---
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
SLACK_STATE_SECRET=
SLACK_OAUTH_REDIRECT_URL=http://localhost:3003/apps/slack/oauth-callback
# Recommended when storing multi-workspace Slack installations
SLACK_ENCRYPTION_KEY=

# --- Accounting integrations (optional) ---
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
XERO_OAUTH_REDIRECT_URL=http://localhost:3003/apps/xero/oauth-callback
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
QUICKBOOKS_OAUTH_REDIRECT_URL=http://localhost:3003/apps/quickbooks/oauth-callback
QUICKBOOKS_ENVIRONMENT=sandbox
FORTNOX_CLIENT_ID=
FORTNOX_CLIENT_SECRET=
FORTNOX_OAUTH_REDIRECT_URL=http://localhost:3003/apps/fortnox/oauth-callback

# --- Invoice payments via Stripe Connect (optional) ---
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_CONNECT_CLIENT_ID=
STRIPE_CONNECT_WEBHOOK_SECRET=
