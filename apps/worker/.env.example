# Worker (apps/worker) — runtime environment
# The BullMQ worker is on its way out (FF-1368 moves every job to Trigger.dev).
# Until then it needs the same database, Supabase, Redis and provider values as the API.

# --- Environment ---
NODE_ENV=development
# "staging" makes the invoice processors log instead of act; leave empty otherwise.
WORKER_ENV=
PORT=8080

# --- Scheduled jobs (on unless set to "false") ---
SYNC_INSTITUTIONS_ENABLED=true
RATES_SCHEDULER_ENABLED=true
NO_MATCH_SCHEDULER_ENABLED=true

# --- URLs (required in production; used for links in emails) ---
DASHBOARD_URL=http://localhost:3001
API_URL=http://localhost:3003
# Optional: where email images are served from; defaults to DASHBOARD_URL.
# EMAIL_ASSETS_URL=

# --- Database (Supabase session pooler) ---
DATABASE_URL=

# --- Supabase (storage and auth) ---
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# --- Redis ---
REDIS_URL=redis://localhost:6379
REDIS_QUEUE_URL=redis://localhost:6379

# --- Secrets (must match the API) ---
INVOICE_JWT_SECRET=

# --- Banking (Enable Banking is required; GoCardless is optional) ---
ENABLEBANKING_APPLICATION_ID=
ENABLE_BANKING_KEY_CONTENT=
ENABLEBANKING_REDIRECT_URL=
GOCARDLESS_SECRET_ID=
GOCARDLESS_SECRET_KEY=


# --- Email (Resend) ---
RESEND_API_KEY=
# Who email is sent from. Required to send at all; the domain has to be
# verified with Resend or the message fails DKIM.
EMAIL_FROM=Midday <midday@example.com>
# Optional: overrides the display name above (invoices still send under the
# team's name).
# EMAIL_FROM_NAME=

# --- AI ---
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
MISTRAL_API_KEY=
# Exa web search (optional)
EXA_API_KEY=
# CompanyEnrich customer enrichment (optional)
COMPANY_ENRICH_API_KEY=

# --- Weekly insights (set to "true" to enable generation + emails) ---
INSIGHTS_ENABLED=false

# --- Slack app (optional) ---
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
SLACK_STATE_SECRET=
SLACK_OAUTH_REDIRECT_URL=http://localhost:3003/apps/slack/oauth-callback

# --- Accounting integrations (optional) ---
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
XERO_OAUTH_REDIRECT_URL=http://localhost:3003/apps/xero/oauth-callback
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
QUICKBOOKS_OAUTH_REDIRECT_URL=http://localhost:3003/apps/quickbooks/oauth-callback
QUICKBOOKS_ENVIRONMENT=sandbox
FORTNOX_CLIENT_ID=
FORTNOX_CLIENT_SECRET=
FORTNOX_OAUTH_REDIRECT_URL=http://localhost:3003/apps/fortnox/oauth-callback

# --- Optional: health check board ---
BOARD_USERNAME=
BOARD_PASSWORD=
